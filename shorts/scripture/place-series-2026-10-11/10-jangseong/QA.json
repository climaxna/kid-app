  "timings": [
    {
      "start": 0.35,
      "voice_end": 4.400544217687075,
      "text": "이 옛 성당이, 한때 아이들의 유치원이었던 걸 아시나요?",
      "display": "이 옛 성당이\n한때 아이들의\n유치원이었다고요?",
