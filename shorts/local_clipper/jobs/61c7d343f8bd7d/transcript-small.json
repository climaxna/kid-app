[
  {
    "start": 3.98,
    "end": 5.78,
    "text": "아 근데 이게 말이 돼요?"
  },
  {
    "start": 5.78,
    "end": 8.38,
    "text": "아 왜 우리 팀이 자첸데서 타고 전화 합쳐지는 거예요?"
  },
  {
    "start": 8.38,
    "end": 10.78,
    "text": "재정이 어렵대잖아 재정이."
  },
  {
    "start": 12.75,
    "end": 15.05,
    "text": "지금 내매 사귀로 사운드 하려고 했는데."
  },
  {
    "start": 15.05,
    "end": 17.39,
    "text": "회사까지."
  },
  {
    "start": 17.39,
    "end": 18.49,
    "text": "오 쟤네."
  },
  {
    "start": 18.49,
    "end": 19.49,
    "text": "Are you okay?"
  },
  {
    "start": 19.49,
    "end": 20.69,
    "text": "What problem?"
  },
  {
    "start": 20.69,
    "end": 22.59,
    "text": "야 아무튼 소리가 진짜 빠졌네."
  },
  {
    "start": 22.59,
    "end": 25.19,
    "text": "그냥 반짝은 영어 쓰지 말고 이렇게 된 마당에 그냥."
  },
  {
    "start": 25.19,
    "end": 26.59,
    "text": "욕심 차려라요."
  },
  {
    "start": 26.59,
    "end": 27.89,
    "text": "수지 팀장님."
  },
  {
    "start": 27.89,
    "end": 28.79,
    "text": "Yes."
  },
  {
    "start": 28.79,
    "end": 29.59,
    "text": "I'm sorry."
  },
  {
    "start": 32.69,
    "end": 33.79,
    "text": "여, 여긴 해."
  },
  {
    "start": 34.19,
    "end": 38.59,
    "text": "근데 소문에 저 디자인 팀 사운드를 한 명씩 사라진다는 얘기가 있어."
  },
  {
    "start": 38.59,
    "end": 41.13,
    "text": "갑자기 병가를 낸다거나 하면서요."
  },
  {
    "start": 41.13,
    "end": 42.99,
    "text": "에이, 그거 다 소문이에요."
  },
  {
    "start": 42.99,
    "end": 44.73,
    "text": "희망 퇴직 한 거겠죠?"
  },
  {
    "start": 44.73,
    "end": 45.43,
    "text": "들어가시죠."
  },
  {
    "start": 45.43,
    "end": 46.33,
    "text": "그래."
  },
  {
    "start": 46.33,
    "end": 49.33,
    "text": "아, 조심하세요."
  },
  {
    "start": 49.33,
    "end": 54.88,
    "text": "뭐야, 뭐야."
  },
  {
    "start": 54.88,
    "end": 56.34,
    "text": "여기 사무실로 하죠?"
  },
  {
    "start": 56.34,
    "end": 68.58,
    "text": "하신 분들이구나."
  },
  {
    "start": 68.58,
    "end": 69.62,
    "text": "안녕하세요."
  },
  {
    "start": 69.62,
    "end": 71.92,
    "text": "전종사예요."
  },
  {
    "start": 71.92,
    "end": 72.92,
    "text": "안녕하세요."
  },
  {
    "start": 72.92,
    "end": 79.29,
    "text": "안녕하세요."
  },
  {
    "start": 79.29,
    "end": 81.39,
    "text": "사람들이 새로 왔어."
  },
  {
    "start": 81.39,
    "end": 87.84,
    "text": "대체 왜 그러는 거예요?"
  },
  {
    "start": 87.84,
    "end": 90.08,
    "text": "와 사무신 너무 레트로한데?"
  },
  {
    "start": 90.08,
    "end": 91.4,
    "text": "스나이프!"
  },
  {
    "start": 91.4,
    "end": 92.78,
    "text": "여긴 지하의 등이라"
  },
  {
    "start": 92.78,
    "end": 94.38,
    "text": "로비라 너무 가깝잖아?"
  },
  {
    "start": 94.38,
    "end": 96.62,
    "text": "완전 럭키 앤이잖아?"
  },
  {
    "start": 96.62,
    "end": 98.18,
    "text": "장원영은 건드지 마라."
  },
  {
    "start": 98.18,
    "end": 99.18,
    "text": "죽인다."
  },
  {
    "start": 99.18,
    "end": 109.13,
    "text": "얘도 자천된 건가?"
  },
  {
    "start": 109.13,
    "end": 115.4,
    "text": "회사의 레이딩스?"
  },
  {
    "start": 115.4,
    "end": 116.96,
    "text": "레이딩스 내 건데."
  },
  {
    "start": 116.96,
    "end": 120.79,
    "text": "저기 종사님."
  },
  {
    "start": 120.79,
    "end": 123.65,
    "text": "그 기회관으로 쓸 만한 자료 좀 정리해 주시겠습니까?"
  },
  {
    "start": 123.65,
    "end": 124.95,
    "text": "네 알겠습니다."
  },
  {
    "start": 126.35,
    "end": 133.86,
    "text": "근데..."
  },
  {
    "start": 133.86,
    "end": 137.99,
    "text": "눈 마주치면 돌로 변할 것 같아, 엄마."
  },
  {
    "start": 137.99,
    "end": 139.69,
    "text": "뭐, 뭐 할 말 있니?"
  },
  {
    "start": 139.69,
    "end": 149.76,
    "text": "잘 가봤습니다."
  },
  {
    "start": 150.68,
    "end": 156.65,
    "text": "다른 것도 커!"
  },
  {
    "start": 165.64,
    "end": 167.64,
    "text": "저렇게 둘이 싸우고 누가 이길까요?"
  },
  {
    "start": 169.64,
    "end": 170.64,
    "text": "있지!"
  },
  {
    "start": 171.64,
    "end": 172.64,
    "text": "세블데이 나인!"
  }
]